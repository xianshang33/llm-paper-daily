# Copy this file to .local/paper-learning.env and fill in your secrets.

export NOTION_TOKEN="ntn_replace_me"
# Feishu custom-bot webhook. Used by paper-learning report delivery AND by the
# paper-daily finalize reminder (run-paper-daily.sh sources this file too).
export FEISHU_WEBHOOK_URL=""
# Optional: set only if the custom bot has "签名校验 / signature verification" enabled.
export FEISHU_WEBHOOK_SECRET=""
